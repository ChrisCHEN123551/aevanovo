{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "aevanovo-enquiry-intake",
  "main": "enquiry-service-intake.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://aevanovo.eu.cc"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aevanovo-enquiries",
      "database_id": "95ecae81-d47e-4523-bab2-63aaa0451cb5"
    }
  ],
  "ratelimits": [
    {
      "name": "ENQUIRY_RATE_LIMITER",
      "namespace_id": "2086001",
      "simple": {
        "limit": 8,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
