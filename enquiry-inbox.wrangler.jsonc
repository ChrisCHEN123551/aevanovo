{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "aevanovo-enquiry-inbox",
  "main": "enquiry-service-inbox.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aevanovo-enquiries",
      "database_id": "95ecae81-d47e-4523-bab2-63aaa0451cb5"
    }
  ],
  "keep_vars": true,
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23liHGtB3mRRYOueou",
    "GITHUB_OWNER_ID": "219934539"
  },
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
